# Laundry Man — frontend environment template (copy to .env)

VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_RAZORPAY_KEY_ID=rzp_test_xxxx

# Location map tiles — MapTiler Free (https://cloud.maptiler.com).
# Create a free account, copy the API key, and paste it here. Never commit
# the real key; .env is git-ignored.
VITE_MAPTILER_API_KEY=

# Phone (OTP) login — Supabase (https://supabase.com).
# 1. Create a project, then copy these from Project Settings → API.
# 2. In Authentication → Providers → Phone, enable it and link an SMS
#    provider (e.g. Twilio) so codes can actually be sent.
# 3. Paste the values into .env and restart the dev server. Without them
#    the app runs in demo mode (any 6-digit code passes).
#
# To test without Twilio: Authentication → Phone → "Test phone numbers" —
# add your number there with a fixed OTP. That number then signs in through
# the normal Supabase flow (creating a real auth session) but skips the SMS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BETA_AUTH=true

