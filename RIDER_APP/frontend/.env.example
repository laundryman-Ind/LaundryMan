# Rider App — frontend environment template (copy to .env)
#
# Dedicated Supabase project for Rider App delivery partner auth & data isolation.
#
# 1. Create a dedicated Rider Supabase project (or configure rider auth instance).
# 2. Copy the Project URL and anon public key from Project Settings → API.
# 3. Paste into .env and restart Vite dev server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BETA_AUTH=true

